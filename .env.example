# Grimoire 환경 변수 예시
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요. (.env* 는 git에서 제외됩니다)

# 세션 암호화 키. 생성: npx auth secret
AUTH_SECRET=

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ── 지식그래프 추출기 ────────────────────────────────────────────────
# none   : 정적 분석만 (매니페스트·언어·토픽·커밋 날짜). 비용 0, 외부 전송 0.
# ollama : 로컬 Ollama로 개념/문제까지 추출. 데이터가 이 컴퓨터를 벗어나지 않음.
# claude : Anthropic API 사용 — 아래 경고 참고. 직접 적어 넣어야만 동작함.
# auto   : (기본값) Ollama가 떠 있으면 ollama, 아니면 none.
#          ANTHROPIC_API_KEY가 있어도 절대 claude를 고르지 않는다 (PLANNING.md §7).
GRAPH_EXTRACTOR=auto

# 로컬 Ollama (docker compose --profile llm 사용 시 컨테이너가 자동 주입)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ── 외부 API 추출기 (opt-in 전용) ────────────────────────────────────
# ⚠ 경고: GRAPH_EXTRACTOR=claude 로 두면 레포별 **커밋 메시지 다이제스트와
#   README 발췌**(private 레포 포함)가 Anthropic API로 전송됩니다.
#   프라이버시 원칙(PLANNING.md §7)상 기본값은 로컬입니다. 아래 두 줄은
#   외부 전송을 감수하고 쓰기로 한 경우에만 주석을 푸세요.
# CLAUDE_EXTRACT_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=

# ── MCP 서버 (npm run mcp / compose --profile mcp) ───────────────────
# 어떤 사용자의 그래프(data/graph/{login}.json)를 열지. 그래프가 하나뿐이면 비워도 됩니다.
GRIMOIRE_LOGIN=
# 데이터 디렉터리를 직접 지정할 때만 (기본: 실행 위치의 ./data)
# GRIMOIRE_DATA_DIR=

# stdio : (기본) Claude Desktop/Cursor가 로컬 프로세스로 띄우는 방식. 인증 불필요.
# http  : 개인 서버에 올려 원격에서 붙는 방식. MCP_AUTH_TOKEN이 **필수**입니다.
MCP_TRANSPORT=stdio
MCP_PORT=8765
# ⚠ http 모드 전용. 비어 있으면 서버가 기동을 거부합니다 (토큰 없는 원격 노출 금지).
#   생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   TLS는 리버스 프록시(Caddy)나 Cloudflare Tunnel이 담당합니다 — README 참고.
MCP_AUTH_TOKEN=

# ── Docker (compose --profile db) ────────────────────────────────────
# Neo4j 비밀번호. 2차(그래프 DB 전환) 때 사용하며 지금 코드는 쓰지 않습니다.
NEO4J_PASSWORD=
