# Grimoire 환경 변수 예시
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요. (.env* 는 git에서 제외됩니다)

# 세션 암호화 키. 생성: npx auth secret
AUTH_SECRET=

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
