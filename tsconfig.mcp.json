{
  // MCP 서버 전용 빌드 — src/mcp와 그가 쓰는 src/lib만 CommonJS로 컴파일한다.
  // (Next/React 코드 경로는 전혀 포함하지 않는다: PLANNING.md §5 "MCP는 stdio 프로세스")
  //
  //   npm run mcp:build   → dist-mcp/mcp/server.js
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-mcp",
    "rootDir": "src",
    // package.json에 "type"이 없으므로 nodenext는 CommonJS로 내보낸다 → node로 바로 실행 가능.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "incremental": false,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"],
    "plugins": []
  },
  "include": ["src/mcp/**/*.ts", "src/lib/**/*.ts"],
  "exclude": ["node_modules"]
}
